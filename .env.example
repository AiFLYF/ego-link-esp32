# rw1 服务端可选配置：真实大模型（OpenAI 兼容端点）
# 用法：复制本文件为 .env 并填入真实值。.env 已在 .gitignore 中，密钥绝不入库。
# server.py 的 _load_dotenv() 只读取 RW1_ 前缀的键、只补缺省（已存在的环境变量优先）。

# 必填：API 密钥（不配则整个 AI 功能自动降级为本地规则 AI，不影响其它功能）
RW1_LLM_API_KEY=

# OpenAI 兼容端点的 base URL（不要带结尾斜杠；默认 https://api.openai.com/v1）
RW1_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名（默认 gpt-4o-mini）
RW1_LLM_MODEL=qwen-turbo

# 单次请求超时秒数（网页提问用；默认 25）
RW1_LLM_TIMEOUT=25

# 板端提问（BOOT 单击 / 语音）的收紧超时秒数（默认 10）：
# reasoning 类模型正文生成常需 10s+，板端等不了那么久，超时回退本地规则 AI。
RW1_LLM_BOARD_TIMEOUT=10

# 失败重试次数（连接故障/超时/429/5xx/非JSON 会重试；4xx 配置错误不重试；默认 2）
RW1_LLM_RETRIES=2

# 注意：某些上游网关（如 Cloudflare 前置的 new-api）按 User-Agent 签名封禁
# Python urllib 的默认 UA（HTTP 403 "error code: 1010"）。server.py 的出站请求
# 统一携带显式 UA（常量 LLM_USER_AGENT = "RW1/1.1"）——请勿删除该请求头。
