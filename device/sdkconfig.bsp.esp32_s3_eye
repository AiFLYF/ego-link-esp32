# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BSP_SELECT_ESP32_S3_EYE=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BSP_DISPLAY_LVGL_TICK=5
CONFIG_BSP_DISPLAY_LVGL_MAX_SLEEP=500
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n

# Custom partition table (3 MB app for WiFi + LVGL)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (Octal) - used for LVGL canvas framebuffer
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# FreeRTOS / main task headroom for the fluid + render task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_HZ=1000

# Allow multiple SNTP servers (Aliyun primary + fallbacks)
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# Newlib float printf (digital clock / debug)
CONFIG_NEWLIB_NANO_FORMAT=n

## LVGL9 ##
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n

#CLIB default
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y

# Fonts used by the watch face
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# Performance monitor (overlay disabled: no on-screen FPS/CPU counter)
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
# CONFIG_LV_USE_PERF_MONITOR is not set

## LVGL8 - uncomment, when using LVGL8 ##
# CONFIG_LV_USE_PERF_MONITOR=y
# CONFIG_LV_COLOR_16_SWAP=y
# CONFIG_LV_MEM_CUSTOM=y
# CONFIG_LV_MEMCPY_MEMSET_STD=y
# CONFIG_LV_SPRINTF_CUSTOM=y


# CJK font so the UI can show Chinese AI replies (LVGL built-in)
CONFIG_LV_USE_TINY_TTF=y

## Camera (on-board OV2640, 8-bit DVP) ##

# 传感器驱动本身默认是 n —— 不开它就根本探测不到摄像头，open("/dev/video2")
# 之后所有 ioctl 都会失败，而且错误信息看不出是"型号没选"。
CONFIG_CAMERA_OV2640=y

# 只开上面那一项的话，唯一可用的格式是 YUYV 640x480（一帧 614KB），
# 走 WiFi 根本传不动。OV2640 的每个格式档位默认也都是 n，要网络传图必须显式开一个，
# 并且明确指定为默认输出格式。QVGA JPEG 约 10-25 KB/帧。
CONFIG_CAMERA_OV2640_DVP_JPEG_320X240_50FPS=y
CONFIG_CAMERA_OV2640_DVP_DEFAULT_FMT_JPEG_320X240_50FPS=y

# ---- 同一块板上还可能是别的模组：三个驱动全开，让 esp_video 自己认 ----
#
# 起因（2026-09-24）：真机报 `failed to detect DVP camera with address=30`，
# 而软件配置、I2C 总线、XCLK 全都没问题。后来发现**不同批次的模组型号不一样**：
#
#   OV2640  地址 0x30，有 JPEG 320x240        ← 最早那批 S3-EYE 用的
#   OV3660  地址 0x3C，有 JPEG（只到 720p）
#   GC2145  地址 0x3C，**没有 JPEG**（只有 RGB565 / YUV422）
#
# 三者都支持 DVP + AUTO_DETECT，所以全开就能自动认出来是哪颗 ——
# 比"猜一个型号"靠谱。代价只是多几十 KB flash（分区还有 44% 余量）。
#
# ⚠️ GC2145 没有硬件 JPEG，所以拿它做"实时画面"时一帧是 320x240 YUV422 ≈ 150 KB，
# 走 WiFi 只能到 1~2 帧/秒（OV2640 的 JPEG 只要 10~25 KB，能到 5 帧/秒）。
CONFIG_CAMERA_OV3660=y
CONFIG_CAMERA_OV3660_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3660_DVP_JPEG_1280X720_12FPS=y
CONFIG_CAMERA_OV3660_DVP_DEFAULT_FMT_JPEG_1280X720_12FPS=y

CONFIG_CAMERA_GC2145=y
CONFIG_CAMERA_GC2145_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_GC2145_DVP_YUV422_YUYV_320X240_13FPS=y
CONFIG_CAMERA_GC2145_DVP_DEFAULT_FMT_YUV422_YUYV_320X240_13FPS=y
